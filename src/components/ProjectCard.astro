---
import type {Project} from '../data/projects'
import GithubGlyph from './GithubGlyph.astro'

type Props = {project: Project}

const {project} = Astro.props

// Spread the slugs around the warm half of the wheel so untextured tiles
// still read as distinct from each other.
const hash = [...project.slug].reduce((acc, ch) => acc + ch.charCodeAt(0), 0)
const hue = 18 + (hash % 40)
const fallback = `linear-gradient(135deg, hsl(${hue} 42% 22%), hsl(${hue + 14} 30% 13%))`
---

<article class="card" class:list={[{wip: project.status === 'wip'}]}>
  <div class="art" style={`background:${fallback}`}>
    <img
      src={`/img/${project.slug}.webp`}
      alt=""
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  </div>

  <div class="body">
    <h3>{project.name}</h3>
    <p class="pitch">{project.pitch}</p>

    <ul class="tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {project.snippet && <code class="snippet">{project.snippet}</code>}

    <div class="actions">
      {
        project.href ? (
          <a class="primary" href={project.href} target="_blank" rel="noopener">
            {project.hrefLabel}
          </a>
        ) : (
          <span class="primary disabled">{project.hrefLabel}</span>
        )
      }
      <a class="gh" href={project.github} target="_blank" rel="noopener">
        <GithubGlyph />
        GitHub
      </a>
      {
        project.blog && (
          <a class="gh" href={project.blog} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
              <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h6.29a1.5 1.5 0 0 1 1.06.44l2.71 2.71a1.5 1.5 0 0 1 .44 1.06V13.5A1.5 1.5 0 0 1 12.5 15h-9A1.5 1.5 0 0 1 2 13.5v-11ZM4.75 7a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 3a.75.75 0 0 0 0 1.5h4a.75.75 0 0 0 0-1.5h-4Z" />
            </svg>
            Blog
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(231, 130, 0, 0.45);
  }

  .art {
    aspect-ratio: 16 / 9;
    position: relative;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    flex: 1;
  }

  h3 {
    font-size: 1.2rem;
  }

  .pitch {
    margin: 0;
    color: rgba(252, 252, 252, 0.74);
    font-size: 0.94rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--secondary);
    border: 1px solid rgba(110, 188, 165, 0.3);
    border-radius: 999px;
    padding: 2px 9px;
  }

  .snippet {
    display: block;
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
    font-size: 0.76rem;
    color: var(--accent-soft);
    overflow-x: auto;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin-top: auto;
    padding-top: 6px;
  }

  .primary {
    background: var(--accent);
    color: #1a1817;
    font-weight: 600;
    font-size: 0.86rem;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 8px;
    transition: background 0.18s ease;
  }

  .primary:hover {
    background: var(--accent-soft);
  }

  .primary.disabled {
    background: transparent;
    border: 1px dashed var(--muted);
    color: var(--muted);
    cursor: default;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .gh:hover {
    color: var(--text);
  }

  .card.wip .art {
    filter: saturate(0.35);
    opacity: 0.75;
  }
</style>
