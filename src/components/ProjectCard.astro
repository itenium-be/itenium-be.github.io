---
import type {Project} from '../data/projects'

type Props = {project: Project}

const {project} = Astro.props

// Spread the slugs around the warm half of the wheel so untextured tiles
// still read as distinct from each other.
const hash = [...project.slug].reduce((acc, ch) => acc + ch.charCodeAt(0), 0)
const hue = 18 + (hash % 40)
const fallback = `linear-gradient(135deg, hsl(${hue} 42% 22%), hsl(${hue + 14} 30% 13%))`
---

<article class="card" class:list={[{wip: project.status === 'wip'}]}>
  <div class="art" style={`background:${fallback}`}>
    <img
      src={`/img/${project.slug}.webp`}
      alt=""
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  </div>

  <div class="body">
    <h3>{project.name}</h3>
    <p class="pitch">{project.pitch}</p>

    <ul class="tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {project.snippet && <code class="snippet">{project.snippet}</code>}

    <div class="actions">
      {
        project.href ? (
          <a class="primary" href={project.href} target="_blank" rel="noopener">
            {project.hrefLabel}
          </a>
        ) : (
          <span class="primary disabled">{project.hrefLabel}</span>
        )
      }
      <a class="gh" href={project.github} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(231, 130, 0, 0.45);
  }

  .art {
    aspect-ratio: 16 / 9;
    position: relative;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    flex: 1;
  }

  h3 {
    font-size: 1.2rem;
  }

  .pitch {
    margin: 0;
    color: rgba(252, 252, 252, 0.74);
    font-size: 0.94rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--secondary);
    border: 1px solid rgba(110, 188, 165, 0.3);
    border-radius: 999px;
    padding: 2px 9px;
  }

  .snippet {
    display: block;
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
    font-size: 0.76rem;
    color: var(--accent-soft);
    overflow-x: auto;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 6px;
  }

  .primary {
    background: var(--accent);
    color: #1a1817;
    font-weight: 600;
    font-size: 0.86rem;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 8px;
    transition: background 0.18s ease;
  }

  .primary:hover {
    background: var(--accent-soft);
  }

  .primary.disabled {
    background: transparent;
    border: 1px dashed var(--muted);
    color: var(--muted);
    cursor: default;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .gh:hover {
    color: var(--text);
  }

  .card.wip .art {
    filter: saturate(0.35);
    opacity: 0.75;
  }
</style>
